<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11 Ultimate ISO Builder" Width="1240" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#0E1014" Foreground="#E6E8EB"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0E1014"/>
    <SolidColorBrush x:Key="Side" Color="#14171D"/>
    <SolidColorBrush x:Key="CardBg" Color="#1A1E26"/>
    <SolidColorBrush x:Key="Field" Color="#11141A"/>
    <SolidColorBrush x:Key="Line" Color="#2A303C"/>
    <SolidColorBrush x:Key="Text" Color="#E6E8EB"/>
    <SolidColorBrush x:Key="Muted" Color="#8B93A1"/>
    <SolidColorBrush x:Key="Accent" Color="#4F8CFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#6FA1FF"/>
    <!-- App logo (sidebar + window/taskbar icon): three window panes and a disc for the ISO -->
    <DrawingImage x:Key="Logo"><DrawingImage.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#4F8CFF" Geometry="M7,0 H25 A7,7 0 0 1 32,7 V25 A7,7 0 0 1 25,32 H7 A7,7 0 0 1 0,25 V7 A7,7 0 0 1 7,0 Z"/>
      <GeometryDrawing Brush="White" Geometry="M7,7 H15 V15 H7 Z M17,7 H25 V15 H17 Z M7,17 H15 V25 H7 Z"/>
      <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><GeometryGroup FillRule="EvenOdd">
        <EllipseGeometry Center="21,21" RadiusX="4.6" RadiusY="4.6"/><EllipseGeometry Center="21,21" RadiusX="1.4" RadiusY="1.4"/>
      </GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <SolidColorBrush x:Key="Danger" Color="#F87171"/>
    <SolidColorBrush x:Key="Success" Color="#34D399"/>
    <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>

    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style x:Key="Sub" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Width" Value="120"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBg}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18,16"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <!-- Page enter animation: fade + small slide up -->
    <Style x:Key="Page" TargetType="FrameworkElement">
      <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Visibility" Value="Visible"><Trigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" DecelerationRatio="1"/>
          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.28" DecelerationRatio="1"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Row" TargetType="StackPanel"><Setter Property="Orientation" Value="Horizontal"/><Setter Property="Margin" Value="0,0,0,10"/></Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="8,0"/><Setter Property="Height" Value="32"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/><Setter Property="Padding" Value="8,0"/><Setter Property="Height" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#232834"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource Line}" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <Border x:Name="hl" CornerRadius="6" Background="White" Opacity="0" IsHitTestVisible="False"/></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="28,11"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid><Border x:Name="b" Background="{StaticResource Accent}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <Border x:Name="hl" CornerRadius="8" Background="White" Opacity="0" IsHitTestVisible="False"/></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
          <Trigger Property="Tag" Value="cancel"><Setter TargetName="b" Property="Background" Value="#B84545"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- On/off switch -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border x:Name="track" Width="38" Height="20" CornerRadius="10" Background="#2A303C" VerticalAlignment="Center">
            <Ellipse x:Name="thumb" Width="14" Height="14" Fill="#C9CED6" HorizontalAlignment="Left" Margin="3,0">
              <Ellipse.RenderTransform><TranslateTransform x:Name="slide"/></Ellipse.RenderTransform></Ellipse></Border>
          <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18" DecelerationRatio="1"/><ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#4F8CFF" Duration="0:0:0.18"/><ColorAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="White" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" DecelerationRatio="1"/><ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#2A303C" Duration="0:0:0.18"/><ColorAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#C9CED6" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Selectable pill (languages, editions) -->
    <Style x:Key="Chip" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid><Border x:Name="b" CornerRadius="14" Padding="12,5" Background="#202530" BorderBrush="{StaticResource Line}" BorderThickness="1">
          <ContentPresenter/></Border>
          <Border x:Name="hl" CornerRadius="14" Background="White" Opacity="0" IsHitTestVisible="False"/></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>

          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#2C3341"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#24365A"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="MinWidth" Value="160"/><Setter Property="Height" Value="32"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Cursor="Hand">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="b" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Fill="{StaticResource Muted}" Data="M0,0 L8,0 L4,5 Z"/></Border>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#1E232D" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
              <ScrollViewer><ItemsPresenter/></ScrollViewer></Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Nav" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="b" CornerRadius="6" Padding="10,7,10,5" Margin="2,0" Background="Transparent">
          <StackPanel>
            <ContentPresenter HorizontalAlignment="Center"/>
            <Border x:Name="bar" Height="2" Width="0" CornerRadius="1" Background="{StaticResource Accent}" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1C2029"/></Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Width" To="22" Duration="0:0:0.2" DecelerationRatio="1"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.2" DecelerationRatio="1"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            <Setter TargetName="b" Property="Background" Value="#1F2633"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Gradient bar; Tag running = light sweeping across it, done = green, error = red -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid><Border Background="#232834" CornerRadius="4"/>
          <Border x:Name="PART_Track"/>
          <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left" ClipToBounds="True">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#3B6FE0" Offset="0"/><GradientStop Color="#7AA7FF" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid>
              <Border x:Name="ok" Opacity="0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1FA97A" Offset="0"/><GradientStop Color="#34D399" Offset="1"/></LinearGradientBrush></Border.Background></Border>
              <Border x:Name="bad" Opacity="0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#C04848" Offset="0"/><GradientStop Color="#F87171" Offset="1"/></LinearGradientBrush></Border.Background></Border>
              <Rectangle x:Name="shine" Width="140" HorizontalAlignment="Left" Opacity="0">
                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#55FFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                <Rectangle.RenderTransform><TranslateTransform x:Name="sweep" X="-140"/></Rectangle.RenderTransform></Rectangle>
            </Grid>
          </Border></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="running">
            <Setter TargetName="shine" Property="Opacity" Value="1"/>
            <Trigger.EnterActions><BeginStoryboard x:Name="sweepAnim"><Storyboard RepeatBehavior="Forever">
              <DoubleAnimation Storyboard.TargetName="sweep" Storyboard.TargetProperty="X" From="-140" To="1400" Duration="0:0:2.4"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><StopStoryboard BeginStoryboardName="sweepAnim"/></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="Tag" Value="done"><Setter TargetName="ok" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="Tag" Value="error"><Setter TargetName="bad" Property="Opacity" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border x:Name="t" Background="#353C4A" CornerRadius="4" Margin="1,0"/>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#4A5366"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

    <!-- Top bar: logo, tabs, preset -->
    <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="20,10,20,10">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <Image Source="{StaticResource Logo}" Width="28" Height="28" Margin="0,0,10,0"/>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="Win11 Ultimate" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="SubTitle" Text="ISO Builder" FontSize="11" Foreground="{StaticResource Muted}"/>
            <!-- Takes the subtitle's place, so it never pushes the tabs off the bar -->
            <Button x:Name="UpdateBtn" Margin="0" Visibility="Collapsed" Cursor="Hand" HorizontalAlignment="Left" ToolTip="Download the newest builder and restart">
              <Button.Template><ControlTemplate TargetType="Button">
                <TextBlock Text="Update available" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextDecorations="Underline"/>
              </ControlTemplate></Button.Template></Button></StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="Summary" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <ComboBox x:Name="Preset" Width="130" ToolTip="Preset: which patches are ticked"/>
          <Button x:Name="SavePreset" Content="Save" Margin="8,0,0,0" ToolTip="Save these settings as a preset in the presets folder (no password or product key)"/>
          <Button x:Name="LoadPreset" Content="Load" Margin="6,0,0,0" ToolTip="Load settings from a preset file"/>
          <Button x:Name="LoadLast" Content="Last" Margin="6,0,0,0" ToolTip="Load the settings of your last build (Auto then picks the newest Windows)"/>
        </StackPanel>
        <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Nav}" VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBoxItem Content="Source" Tag="PageSource" IsSelected="True"/>
          <ListBoxItem Content="Patches" Tag="PagePatches"/>
          <ListBoxItem Content="Unattended" Tag="PageUnattended"/>
          <ListBoxItem Content="Build" Tag="PageBuild"/>
          <ListBoxItem Content="Info" Tag="PageInfo"/>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <!-- Source -->
      <ScrollViewer x:Name="PageSource" Style="{StaticResource Page}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,30,36,30">
        <TextBlock Text="Source" Style="{StaticResource H1}"/>
        <TextBlock Text="Pick what goes on the ISO, then where the files come from. Your own ISOs are used first; anything missing is downloaded." Style="{StaticResource Sub}"/>
        <!-- 1. What to build -->
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="WINDOWS" Style="{StaticResource Section}"/>
          <StackPanel Style="{StaticResource Row}" Margin="0,0,0,14"><TextBlock Text="Language" Style="{StaticResource Label}"/><ComboBox x:Name="BaseLang" Width="220"/>
            <TextBlock Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center" Text="setup and Windows; keyboard and formats are on the Unattended page"/></StackPanel>
          <DockPanel><TextBlock Text="Editions" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <WrapPanel x:Name="EditionPanel"/></DockPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="120,0,0,0" Text="Tick one or more. Editions marked 'download' are not in your ISOs and get downloaded."/>
        </StackPanel></Border>
        <!-- 2. Where the files come from -->
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="WHERE THE FILES COME FROM" Style="{StaticResource Section}"/>
          <DockPanel><TextBlock Text="Your ISOs" Style="{StaticResource Label}"/>
            <Button x:Name="ScanIsos" DockPanel.Dock="Right" Content="Scan"/>
            <Button x:Name="BrowseIso" DockPanel.Dock="Right" Content="Browse"/>
            <TextBox x:Name="IsoFolder"/></DockPanel>
          <TextBlock x:Name="ScanResult" Style="{StaticResource Hint}" Margin="120,6,0,0" Text="Drop official Windows 11 ISOs into this folder and click Scan."/>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,16"/>
          <CheckBox x:Name="UseUup" Style="{StaticResource Toggle}" Content="Download Windows when your ISOs don't have it (kept in this folder for next builds)" IsChecked="True"/>
          <StackPanel x:Name="UupOptions" Margin="50,0,0,0">
            <StackPanel Style="{StaticResource Row}"><TextBlock Text="Download from" Style="{StaticResource Label}"/>
              <ComboBox x:Name="Download" Width="460">
                <ComboBoxItem Content="Microsoft - official ISO, 8 GB download (latest update installs after setup)" Tag="Microsoft" IsSelected="True"/>
                <ComboBoxItem Content="UUP dump - latest update built in, about 60 min, all editions" Tag="Uup"/>
              </ComboBox></StackPanel>
            <CheckBox x:Name="Newest" Style="{StaticResource Toggle}" Content="Always use the newest Windows (download it if your ISO is an older version)" IsChecked="True"/>
            <StackPanel Style="{StaticResource Row}" Margin="0,4,0,0"><TextBlock Text="Windows version" Style="{StaticResource Label}"/><ComboBox x:Name="Build" Width="380"/></StackPanel>
            <TextBlock x:Name="BuildHint" Style="{StaticResource Hint}" Margin="120,6,0,0" Text="Auto picks the newest build matching your ISO."/>
          </StackPanel>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>

      <!-- Patches -->
      <ScrollViewer x:Name="PagePatches" Style="{StaticResource Page}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,30,36,30">
        <TextBlock Text="Patches" Style="{StaticResource H1}"/>
        <TextBlock Text="CTT Win11 Creator style tweaks, applied to every edition. Essential apps (Store, winget, Calculator, Photos, Xbox login, Game Bar...) are always protected." Style="{StaticResource Sub}"/>
        <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel>
          <TextBlock Text="WHEN PATCHES ARE APPLIED" Style="{StaticResource Section}"/>
          <ComboBox x:Name="PatchMode" Width="460" HorizontalAlignment="Left">
            <ComboBoxItem Content="Into the image - build takes about 10 min per edition" Tag="Image" IsSelected="True"/>
            <ComboBoxItem Content="During Windows setup - build in a few minutes (like CTT Win11 Creator)" Tag="Setup"/>
          </ComboBox>
          <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" Text="Into the image: every edition is patched while building, so the patches are there however Windows gets installed. During setup: the image stays exactly as Microsoft made it; this ISO's answer file applies the patches while Windows installs, before the first login (log: C:\Windows\Setup\Scripts\Win11Ultimate-patches.log). Patches are missing if you install another way, e.g. an upgrade started from inside Windows."/>
        </StackPanel></Border>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel x:Name="PatchCol0"/><StackPanel x:Name="PatchCol1" Grid.Column="1"/><StackPanel x:Name="PatchCol2" Grid.Column="2"/></Grid>
        <StackPanel x:Name="PatchWide"/>
        <!-- Moved under the 'Add drivers from folder' toggle by Builder.ps1 -->
        <StackPanel Visibility="Collapsed"><StackPanel x:Name="DriverRow" Margin="50,0,0,10">
          <DockPanel><Button x:Name="BrowseDrivers" DockPanel.Dock="Right" Content="Browse"/><TextBox x:Name="DriversPath"/></DockPanel>
        </StackPanel></StackPanel>
      </StackPanel></ScrollViewer>

      <!-- Unattended -->
      <ScrollViewer x:Name="PageUnattended" Style="{StaticResource Page}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,30,36,30">
        <TextBlock Text="Unattended" Style="{StaticResource H1}"/>
        <TextBlock Text="Optional: let setup answer its own questions, so installing Windows needs (almost) no clicks." Style="{StaticResource Sub}"/>
        <Border x:Name="UnattendCard" Style="{StaticResource Card}" Padding="20,18"><StackPanel>
          <CheckBox x:Name="UnattendOn" Style="{StaticResource Toggle}" Margin="0">
            <TextBlock Text="Answer setup's questions automatically" FontSize="15" FontWeight="SemiBold"/></CheckBox>
          <TextBlock x:Name="UnattendHint" Style="{StaticResource Hint}" Margin="50,4,0,0"
                     Text="Off: normal Windows setup. On: account, region, Wi-Fi, apps and optionally a fully automatic install (written to autounattend.xml)."/>
        </StackPanel></Border>
        <StackPanel x:Name="UnattendBody">
          <!-- Red border and warning only while a disk-wiping option is picked (Builder.ps1) -->
          <Border x:Name="InstallCard" Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="INSTALL" Style="{StaticResource Section}"/>
            <StackPanel Style="{StaticResource Row}"><CheckBox x:Name="SkipEdition" Style="{StaticResource Toggle}" Content="Skip edition choice" Width="200" Margin="0"/><ComboBox x:Name="Edition" Width="260"/></StackPanel>
            <StackPanel Style="{StaticResource Row}"><TextBlock Text="Product key" Style="{StaticResource Label}" Width="200"/><TextBox x:Name="ProductKey" Width="260"/>
              <TextBlock Text="empty = enter later or use the PC's digital license" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
            <StackPanel Style="{StaticResource Row}" Margin="0"><TextBlock Text="Disk" Style="{StaticResource Label}" Width="200"/>
              <ComboBox x:Name="AutoInstall" Width="420">
                <ComboBoxItem Content="Off - choose the disk in setup (safe)" Tag="Off" IsSelected="True"/>
                <ComboBoxItem Content="Best SSD - wipe only if there is one clear choice" Tag="BestSsd"/>
                <ComboBoxItem Content="Disk 0 - always wipe disk 0" Tag="Disk0"/>
              </ComboBox></StackPanel>
            <TextBlock x:Name="DiskHint" Style="{StaticResource Hint}" Margin="200,6,0,0" Text="Best SSD prefers NVMe, then SSD, then HDD, never USB or disks under 64 GB, and shows a popup with 10 seconds to cancel. If two disks tie, normal setup opens and a popup says why. Needs 'Skip edition choice'. Any PC booted from this ISO can be wiped."/>
          </StackPanel></Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="ACCOUNT" Style="{StaticResource Section}"/>
                <StackPanel Style="{StaticResource Row}"><TextBlock Text="Username" Style="{StaticResource Label}"/><TextBox x:Name="UserName" Width="220" Text="User"/></StackPanel>
                <StackPanel Style="{StaticResource Row}"><TextBlock Text="Password" Style="{StaticResource Label}"/><PasswordBox x:Name="Password" Width="220"/>
                  <TextBlock Text="empty = none" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <CheckBox x:Name="AutoLogon" Style="{StaticResource Toggle}" Content="Auto-login on first boot"/>
                <CheckBox x:Name="AdminGroup" Style="{StaticResource Toggle}" Content="Make user administrator" IsChecked="True"/>
                <CheckBox x:Name="SkipOobe" Style="{StaticResource Toggle}" Content="Skip all setup screens (EULA, privacy, Microsoft account, network)" IsChecked="True" Margin="0"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="The password is stored base64-encoded inside the ISO. That is not encryption."/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="WI-FI" Style="{StaticResource Section}"/>
                <StackPanel Style="{StaticResource Row}"><TextBlock Text="Network name" Style="{StaticResource Label}"/><TextBox x:Name="WifiName" Width="220"/>
                  <TextBlock Text="empty = no Wi-Fi" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Style="{StaticResource Row}"><TextBlock Text="Password" Style="{StaticResource Label}"/><PasswordBox x:Name="WifiPassword" Width="220"/>
                  <TextBlock Text="empty = open" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource Warn}" Text="Connects after the first login so apps can install without a cable. The Wi-Fi password is stored in PLAIN TEXT on the ISO / USB stick. It is never saved in config.json or presets."/>
              </StackPanel></Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="REGION" Style="{StaticResource Section}"/>
                <StackPanel Style="{StaticResource Row}"><TextBlock Text="Computer name" Style="{StaticResource Label}"/><TextBox x:Name="ComputerName" Width="220"/>
                  <TextBlock Text="empty = random" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Style="{StaticResource Row}"><TextBlock Text="Timezone" Style="{StaticResource Label}"/><ComboBox x:Name="TimeZone" Width="300"/></StackPanel>
                <StackPanel Style="{StaticResource Row}"><TextBlock Text="Keyboard" Style="{StaticResource Label}"/><ComboBox x:Name="Keyboard" Width="160"/></StackPanel>
                <StackPanel Style="{StaticResource Row}" Margin="0"><TextBlock Text="Locale / format" Style="{StaticResource Label}"/><ComboBox x:Name="Locale" Width="160"/></StackPanel>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="AFTER INSTALL" Style="{StaticResource Section}"/>
                <CheckBox x:Name="RunWinUtil" Style="{StaticResource Toggle}" Content="Run CTT WinUtil after first login"/>
                <CheckBox x:Name="EnableAdmin" Style="{StaticResource Toggle}" Content="Activate the hidden Administrator account"/>
                <DockPanel><TextBlock Text="My script" Style="{StaticResource Label}"/><Button x:Name="BrowseScript" DockPanel.Dock="Right" Content="Browse"/><TextBox x:Name="CustomScript"/></DockPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="120,6,0,0" Text="Your own script, run once after the first login."/>
              </StackPanel></Border>
            </StackPanel>
          </Grid>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="APPS" Style="{StaticResource Section}"/>
            <DockPanel><TextBlock Text="Search winget" Style="{StaticResource Label}"/><Button x:Name="SearchApps" DockPanel.Dock="Right" Content="Search"/><TextBox x:Name="AppSearch"/></DockPanel>
            <WrapPanel x:Name="AppResults" Margin="120,8,0,0"/>
            <DockPanel Margin="0,10,0,0"><TextBlock Text="Will be installed" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,5,0,0"/>
              <WrapPanel x:Name="AppPanel"/></DockPanel>
            <TextBlock x:Name="AppsHint" Style="{StaticResource Hint}" Margin="120,6,0,0" Text="Type a name (e.g. discord) and press Enter, then click a result to add it. Click an added app to remove it. Installed with winget after the first login (needs internet)."/>
          </StackPanel></Border>
        </StackPanel>
      </StackPanel></ScrollViewer>

      <!-- Build -->
      <!-- Fills the window; below MinHeight the page scrolls instead of squeezing the steps and log away -->
      <ScrollViewer x:Name="PageBuild" Style="{StaticResource Page}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <Border x:Name="BuildBody" Padding="36,30,36,30" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Build" Style="{StaticResource H1}" Margin="0,0,0,16"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel>
            <TextBlock Text="PLAN" Style="{StaticResource Section}"/>
            <!-- Filled by Update-Plan: notices on top, one row per decision, time + disk on the right -->
            <StackPanel x:Name="PlanPanel"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel x:Name="PlanRows"/>
              <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="20,0,4,0" Margin="16,0,0,0">
                <StackPanel x:Name="PlanStats"/></Border></Grid>
          </StackPanel></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="OUTPUT" Style="{StaticResource Section}"/>
            <DockPanel Margin="0,0,0,12"><Button x:Name="BrowseOut" DockPanel.Dock="Right" Content="Browse"/><TextBox x:Name="Output"/></DockPanel>
            <CheckBox x:Name="Split" Style="{StaticResource Toggle}" Content="Split install.wim for FAT32 USB"/>
            <CheckBox x:Name="QuickCompress" Style="{StaticResource Toggle}" Content="Quick compression" ToolTip="A few minutes faster per edition; the ISO is about 1 GB bigger."/>
            <CheckBox x:Name="SmallIso" Style="{StaticResource Toggle}" Content="Small ISO (slower)" ToolTip="Saves the image as install.esd (strongest compression, about 10-20 extra minutes per edition). With Microsoft as the source and fewer editions ticked, downloads an image with just those from UUP dump (about 60 minutes instead of 10). Split for FAT32 is skipped."/>
            <CheckBox x:Name="DefenderExclude" Style="{StaticResource Toggle}" Content="Skip Defender scan of work folder" Margin="0" ToolTip="Faster mount/save. Only the work folder is excluded, and only until the build ends."/>
          </StackPanel></Border>
        </Grid>
        <!-- Status: what is happening now, time, progress. Border turns green / red when the build ends. -->
        <Border x:Name="StatusCard" Grid.Row="2" Style="{StaticResource Card}" Padding="20,16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
              <Button x:Name="OpenResult" Content="Show in folder" Margin="0,0,10,0" Padding="16,10" Visibility="Collapsed"/>
              <Button x:Name="BuildBtn" Style="{StaticResource Primary}" Content="Build ISO" MinWidth="160"/></StackPanel>
            <StackPanel VerticalAlignment="Center">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="16,0,0,0">
                  <TextBlock x:Name="Elapsed" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="Eta" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></StackPanel>
                <StackPanel>
                  <TextBlock x:Name="StepTitle" Text="Ready to build" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock x:Name="StepText" Text="Check the plan, then click Build ISO." Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
              </DockPanel>
              <ProgressBar x:Name="Progress" Maximum="9" Height="8" Margin="0,14,0,0"/></StackPanel>
          </DockPanel>
        </Border>
        <!-- Builder.ps1 raises BuildBody.MinHeight so this row never gets smaller than the 9 steps need; the page scrolls instead -->
        <Grid x:Name="BuildBottom" Grid.Row="3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <!-- Step list, filled by Builder.ps1: 9 equal rows that share the height, no scrolling -->
          <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18,14">
            <DockPanel><TextBlock Text="STEPS" Style="{StaticResource Section}" DockPanel.Dock="Top"/>
              <UniformGrid x:Name="StepList" Columns="1" Rows="9"/></DockPanel>
          </Border>
          <Border Grid.Column="1" Background="#0A0C10" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="4">
            <RichTextBox x:Name="Log" Padding="10,8" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         Foreground="#B9C2D0" VerticalScrollBarVisibility="Auto" IsDocumentEnabled="False">
              <RichTextBox.Resources><Style TargetType="Paragraph"><Setter Property="Margin" Value="0,0,0,2"/></Style></RichTextBox.Resources>
              <FlowDocument/></RichTextBox>
          </Border>
        </Grid>
        <!-- Test & storage: one slim line -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,8">
          <DockPanel>
            <Button x:Name="CleanUp" DockPanel.Dock="Right" Content="Clean up" ToolTip="Delete temporary build files and outdated downloads"/>
            <Button x:Name="RemoveVm" DockPanel.Dock="Right" Content="Remove VM" Margin="0,0,10,0" ToolTip="Delete the test VM and its virtual disk"/>
            <Button x:Name="TestVm" DockPanel.Dock="Right" Content="Test in VM" Margin="0,0,10,0" ToolTip="Boot the built ISO in a Hyper-V virtual machine"/>
            <TextBlock x:Name="StorageText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"/></DockPanel></Border>
      </Grid></Border></ScrollViewer>

      <!-- Info -->
      <ScrollViewer x:Name="PageInfo" Style="{StaticResource Page}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,30,36,30">
        <TextBlock Text="Info" Style="{StaticResource H1}"/>
        <TextBlock Text="About this builder and how to use it." Style="{StaticResource Sub}"/>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="ABOUT" Style="{StaticResource Section}"/>
          <StackPanel Style="{StaticResource Row}"><TextBlock Text="Version" Style="{StaticResource Label}"/><TextBlock x:Name="InfoVersion"/></StackPanel>
          <StackPanel Style="{StaticResource Row}"><TextBlock Text="Installed in" Style="{StaticResource Label}"/><TextBlock x:Name="InfoFolder"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Project page" Style="{StaticResource Label}"/>
            <Button x:Name="OpenGitHub" Content="github.com/nussico/win11-ultimate-iso" Padding="10,4"/>
            <Button x:Name="OpenFolder" Content="Open folder" Padding="10,4" Margin="10,0,0,0"/>
            <Button x:Name="OpenPresets" Content="Presets folder" Padding="10,4" Margin="10,0,0,0" ToolTip="Your saved presets. Every .json here shows up in the preset list."/></StackPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="HOW TO USE" Style="{StaticResource Section}"/>
          <TextBlock TextWrapping="Wrap" LineHeight="22">
            <Run FontWeight="SemiBold" Text="1. Source"/><Run Text="  -  pick the language and tick the editions. Your own ISOs in the sources folder are used, anything missing is downloaded."/><LineBreak/>
            <Run FontWeight="SemiBold" Text="2. Patches"/><Run Text="  -  pick a preset at the top right or tick patches yourself. Essential apps are always kept."/><LineBreak/>
            <Run FontWeight="SemiBold" Text="3. Unattended"/><Run Text="  -  optional: account, language, keyboard and automatic install, so setup asks nothing."/><LineBreak/>
            <Run FontWeight="SemiBold" Text="4. Build"/><Run Text="  -  check the plan, click Build ISO, then Test in VM. Put the ISO on a USB stick with Rufus or Ventoy."/>
          </TextBlock>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Danger}"><StackPanel>
          <TextBlock Text="GOOD TO KNOW" Style="{StaticResource Section}" Foreground="{StaticResource Danger}"/>
          <TextBlock TextWrapping="Wrap" LineHeight="22">
            <Run Text="- Automatic install (Best SSD, Disk 0) ERASES a disk on any PC booted from that ISO. Label the USB stick."/><LineBreak/>
            <Run Text="- Aggressive patches (Edge, Defender, Recall) can break apps or updates."/><LineBreak/>
            <Run Text="- Activation: use your own key or the PC's digital license. No activation tools are included."/><LineBreak/>
            <Run Text="- Not affiliated with Microsoft, Chris Titus Tech or UUP dump. Use at your own risk. MIT license."/>
          </TextBlock>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>
    </Grid>
  </Grid>
</Window>
