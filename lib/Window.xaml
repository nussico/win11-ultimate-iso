<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11 Ultimate ISO Builder" Width="1240" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#0E1014" Foreground="#E6E8EB"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0E1014"/>
    <SolidColorBrush x:Key="Side" Color="#14171D"/>
    <SolidColorBrush x:Key="CardBg" Color="#1A1E26"/>
    <SolidColorBrush x:Key="Field" Color="#11141A"/>
    <SolidColorBrush x:Key="Line" Color="#2A303C"/>
    <SolidColorBrush x:Key="Text" Color="#E6E8EB"/>
    <SolidColorBrush x:Key="Muted" Color="#8B93A1"/>
    <SolidColorBrush x:Key="Accent" Color="#4F8CFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#6FA1FF"/>
    <SolidColorBrush x:Key="Danger" Color="#F87171"/>

    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style x:Key="Sub" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Width" Value="120"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBg}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18,16"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <!-- Page enter animation: fade + small slide up -->
    <Style x:Key="Page" TargetType="FrameworkElement">
      <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Visibility" Value="Visible"><Trigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" DecelerationRatio="1"/>
          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.28" DecelerationRatio="1"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Row" TargetType="StackPanel"><Setter Property="Orientation" Value="Horizontal"/><Setter Property="Margin" Value="0,0,0,10"/></Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="8,0"/><Setter Property="Height" Value="32"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/><Setter Property="Padding" Value="8,0"/><Setter Property="Height" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#232834"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource Line}" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <Border x:Name="hl" CornerRadius="6" Background="White" Opacity="0" IsHitTestVisible="False"/></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="28,11"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid><Border x:Name="b" Background="{StaticResource Accent}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <Border x:Name="hl" CornerRadius="8" Background="White" Opacity="0" IsHitTestVisible="False"/></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
          <Trigger Property="Tag" Value="cancel"><Setter TargetName="b" Property="Background" Value="#B84545"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- On/off switch -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border x:Name="track" Width="38" Height="20" CornerRadius="10" Background="#2A303C" VerticalAlignment="Center">
            <Ellipse x:Name="thumb" Width="14" Height="14" Fill="#C9CED6" HorizontalAlignment="Left" Margin="3,0">
              <Ellipse.RenderTransform><TranslateTransform x:Name="slide"/></Ellipse.RenderTransform></Ellipse></Border>
          <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18" DecelerationRatio="1"/><ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#4F8CFF" Duration="0:0:0.18"/><ColorAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="White" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" DecelerationRatio="1"/><ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#2A303C" Duration="0:0:0.18"/><ColorAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#C9CED6" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Selectable pill (languages, editions) -->
    <Style x:Key="Chip" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid><Border x:Name="b" CornerRadius="14" Padding="12,5" Background="#202530" BorderBrush="{StaticResource Line}" BorderThickness="1">
          <ContentPresenter/></Border>
          <Border x:Name="hl" CornerRadius="14" Background="White" Opacity="0" IsHitTestVisible="False"/></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>

          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#2C3341"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#24365A"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="MinWidth" Value="160"/><Setter Property="Height" Value="32"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Cursor="Hand">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="b" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Fill="{StaticResource Muted}" Data="M0,0 L8,0 L4,5 Z"/></Border>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#1E232D" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
              <ScrollViewer><ItemsPresenter/></ScrollViewer></Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Nav" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="b" CornerRadius="6" Padding="14,9" Margin="10,2" Background="Transparent">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="bar" Width="3" Height="0" CornerRadius="2" Background="{StaticResource Accent}" Margin="0,0,12,0"/>
            <ContentPresenter VerticalAlignment="Center"/></StackPanel></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1C2029"/></Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Height" To="16" Duration="0:0:0.2" DecelerationRatio="1"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.2" DecelerationRatio="1"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            <Setter TargetName="b" Property="Background" Value="#1F2633"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid><Border Background="#232834" CornerRadius="3"/>
          <Border x:Name="PART_Track"/><Border x:Name="PART_Indicator" Background="{StaticResource Accent}" CornerRadius="3" HorizontalAlignment="Left"/></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border x:Name="t" Background="#353C4A" CornerRadius="4" Margin="1,0"/>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#4A5366"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="24,26,20,24">
          <StackPanel Orientation="Horizontal">
            <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource Accent}" Margin="0,0,10,0">
              <TextBlock Text="W" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel><TextBlock Text="Win11 Ultimate" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock Text="ISO Builder" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="24,0,20,24">
          <TextBlock Text="PRESET" Style="{StaticResource Section}"/>
          <ComboBox x:Name="Preset"/>
          <TextBlock x:Name="Summary" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
        </StackPanel>
        <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Nav}">
          <ListBoxItem Content="Source" Tag="PageSource" IsSelected="True"/>
          <ListBoxItem Content="Languages" Tag="PageLanguages"/>
          <ListBoxItem Content="Editions" Tag="PageEditions"/>
          <ListBoxItem Content="Patches" Tag="PagePatches"/>
          <ListBoxItem Content="Unattended" Tag="PageUnattended"/>
          <ListBoxItem Content="Build" Tag="PageBuild"/>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <!-- Source -->
      <ScrollViewer x:Name="PageSource" Style="{StaticResource Page}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,30,36,30">
        <TextBlock Text="Source" Style="{StaticResource H1}"/>
        <TextBlock Text="Where the Windows files come from. Your own official ISOs are used first; anything missing can be downloaded from UUP dump." Style="{StaticResource Sub}"/>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="YOUR ISOS" Style="{StaticResource Section}"/>
          <DockPanel>
            <Button x:Name="ScanIsos" DockPanel.Dock="Right" Content="Scan"/>
            <Button x:Name="BrowseIso" DockPanel.Dock="Right" Content="Browse"/>
            <TextBox x:Name="IsoFolder"/></DockPanel>
          <TextBlock x:Name="ScanResult" Style="{StaticResource Hint}" Text="Drop official Windows 11 ISOs into this folder and click Scan."/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="UUP DUMP" Style="{StaticResource Section}"/>
          <CheckBox x:Name="UseUup" Style="{StaticResource Toggle}" Content="Download missing editions via UUP dump" IsChecked="True"/>
          <CheckBox x:Name="Newest" Style="{StaticResource Toggle}" Content="Always use the newest Windows (download it if your ISO is an older version)" IsChecked="True"/>
          <CheckBox x:Name="Fast" Style="{StaticResource Toggle}" Content="Fast mode: ~15 min instead of ~60 (older base build; Windows Update updates it after setup)" IsChecked="True"/>
          <TextBlock x:Name="NewestText" Style="{StaticResource Hint}" Margin="0,0,0,12" Text="Newest available: unknown (offline)"/>
          <StackPanel Style="{StaticResource Row}"><TextBlock Text="Build" Style="{StaticResource Label}"/><ComboBox x:Name="Build" Width="380"/></StackPanel>
          <TextBlock Style="{StaticResource Hint}" Text="Auto picks the newest build matching your ISO."/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>

      <!-- Languages -->
      <ScrollViewer x:Name="PageLanguages" Style="{StaticResource Page}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,30,36,30">
        <TextBlock Text="Languages" Style="{StaticResource H1}"/>
        <TextBlock Text="The ISO is built in this one language: setup and Windows. Keyboard and formats can still be set on the Unattended page." Style="{StaticResource Sub}"/>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="BASE LANGUAGE" Style="{StaticResource Section}"/>
          <ComboBox x:Name="BaseLang" Width="200" HorizontalAlignment="Left"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>

      <!-- Editions -->
      <ScrollViewer x:Name="PageEditions" Style="{StaticResource Page}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,30,36,30">
        <TextBlock Text="Editions" Style="{StaticResource H1}"/>
        <TextBlock Text="Editions found in your ISO for the base language. Ones marked UUP are built via UUP dump." Style="{StaticResource Sub}"/>
        <Border Style="{StaticResource Card}"><WrapPanel x:Name="EditionPanel"/></Border>
      </StackPanel></ScrollViewer>

      <!-- Patches -->
      <ScrollViewer x:Name="PagePatches" Style="{StaticResource Page}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,30,36,30">
        <TextBlock Text="Patches" Style="{StaticResource H1}"/>
        <TextBlock Text="CTT Win11 Creator style tweaks, applied to every edition. Essential apps (Store, winget, Calculator, Photos, Xbox login, Game Bar...) are always protected." Style="{StaticResource Sub}"/>
        <UniformGrid x:Name="PatchPanel" Columns="2"/>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="DRIVER FOLDER" Style="{StaticResource Section}"/>
          <DockPanel><Button x:Name="BrowseDrivers" DockPanel.Dock="Right" Content="Browse"/><TextBox x:Name="DriversPath"/></DockPanel>
          <TextBlock Style="{StaticResource Hint}" Text="Used when 'Add drivers from folder' is on. Newer builds may ignore BypassNRO - the unattended local account is the reliable route."/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>

      <!-- Unattended -->
      <ScrollViewer x:Name="PageUnattended" Style="{StaticResource Page}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,30,36,30">
        <TextBlock Text="Unattended" Style="{StaticResource H1}"/>
        <TextBlock Text="Generates autounattend.xml so setup answers its own questions." Style="{StaticResource Sub}"/>
        <CheckBox x:Name="UnattendOn" Style="{StaticResource Toggle}" Content="Enable autounattend.xml" Margin="0,0,0,16"/>
        <StackPanel x:Name="UnattendBody">
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="ACCOUNT" Style="{StaticResource Section}"/>
            <StackPanel Style="{StaticResource Row}"><TextBlock Text="Username" Style="{StaticResource Label}"/><TextBox x:Name="UserName" Width="220" Text="User"/></StackPanel>
            <StackPanel Style="{StaticResource Row}"><TextBlock Text="Password" Style="{StaticResource Label}"/><PasswordBox x:Name="Password" Width="220"/>
              <TextBlock Text="empty = no password" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
            <CheckBox x:Name="AutoLogon" Style="{StaticResource Toggle}" Content="Auto-login on first boot"/>
            <CheckBox x:Name="AdminGroup" Style="{StaticResource Toggle}" Content="Make user administrator" IsChecked="True"/>
            <TextBlock Style="{StaticResource Hint}" Text="The password is stored base64-encoded inside the ISO. That is not encryption."/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="REGION" Style="{StaticResource Section}"/>
            <StackPanel Style="{StaticResource Row}"><TextBlock Text="Computer name" Style="{StaticResource Label}"/><TextBox x:Name="ComputerName" Width="220"/>
              <TextBlock Text="empty = random" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
            <StackPanel Style="{StaticResource Row}"><TextBlock Text="Timezone" Style="{StaticResource Label}"/><ComboBox x:Name="TimeZone" Width="340"/></StackPanel>
            <StackPanel Style="{StaticResource Row}"><TextBlock Text="Keyboard" Style="{StaticResource Label}"/><ComboBox x:Name="Keyboard" Width="160"/></StackPanel>
            <StackPanel Style="{StaticResource Row}" Margin="0"><TextBlock Text="Locale / format" Style="{StaticResource Label}"/><ComboBox x:Name="Locale" Width="160"/></StackPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="SETUP" Style="{StaticResource Section}"/>
            <CheckBox x:Name="SkipOobe" Style="{StaticResource Toggle}" Content="Skip all OOBE screens (EULA, privacy, Microsoft account, network)" IsChecked="True"/>
            <StackPanel Style="{StaticResource Row}"><CheckBox x:Name="SkipEdition" Style="{StaticResource Toggle}" Content="Skip edition choice" Width="200" Margin="0"/><ComboBox x:Name="Edition" Width="260"/></StackPanel>
            <StackPanel Style="{StaticResource Row}"><TextBlock Text="Product key" Style="{StaticResource Label}"/><TextBox x:Name="ProductKey" Width="300"/></StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="Your own key. Empty = enter later, or the PC's digital license activates it automatically."/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" BorderBrush="#5A2A2A"><StackPanel>
            <TextBlock Text="AUTOMATIC INSTALL" Style="{StaticResource Section}" Foreground="{StaticResource Danger}"/>
            <ComboBox x:Name="AutoInstall" Width="420" HorizontalAlignment="Left">
              <ComboBoxItem Content="Off - choose the disk in setup (safe)" Tag="Off" IsSelected="True"/>
              <ComboBoxItem Content="Best SSD - wipe only if there is one clear choice" Tag="BestSsd"/>
              <ComboBoxItem Content="Disk 0 - always wipe disk 0" Tag="Disk0"/>
            </ComboBox>
            <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource Danger}" Text="Best SSD prefers NVMe, then SSD, then HDD, never USB or disks under 64 GB, and shows a 10 second cancel countdown. If two disks tie, normal setup opens instead. Needs 'Skip edition choice'. Any PC booted from this ISO can be wiped."/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="AFTER INSTALL" Style="{StaticResource Section}"/>
            <CheckBox x:Name="RunWinUtil" Style="{StaticResource Toggle}" Content="Run CTT WinUtil after first login"/>
            <CheckBox x:Name="EnableAdmin" Style="{StaticResource Toggle}" Content="Activate the hidden Administrator account"/>
            <DockPanel><TextBlock Text="My script" Style="{StaticResource Label}"/><Button x:Name="BrowseScript" DockPanel.Dock="Right" Content="Browse"/><TextBox x:Name="CustomScript"/></DockPanel>
          </StackPanel></Border>
        </StackPanel>
      </StackPanel></ScrollViewer>

      <!-- Build -->
      <Grid x:Name="PageBuild" Style="{StaticResource Page}" Visibility="Collapsed" Margin="36,30,36,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Build" Style="{StaticResource H1}"/>
          <TextBlock Text="Needs about 60 GB free on the project drive. A full build takes a while - the log shows every step." Style="{StaticResource Sub}"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="OUTPUT" Style="{StaticResource Section}"/>
          <DockPanel Margin="0,0,0,12"><Button x:Name="BrowseOut" DockPanel.Dock="Right" Content="Browse"/><TextBox x:Name="Output"/></DockPanel>
          <CheckBox x:Name="Split" Style="{StaticResource Toggle}" Content="Split install.wim for FAT32 USB sticks" Margin="0"/>
        </StackPanel></Border>
        <DockPanel Grid.Row="2" Margin="0,4,0,14">
          <Button x:Name="BuildBtn" Style="{StaticResource Primary}" Content="Build ISO" DockPanel.Dock="Right" MinWidth="160"/>
          <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
            <TextBlock x:Name="StepText" Text="Ready" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
            <ProgressBar x:Name="Progress" Maximum="9"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="3" Background="#0A0C10" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="4">
          <TextBox x:Name="Log" Height="Auto" Padding="10,8" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   Foreground="#B9C2D0" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
